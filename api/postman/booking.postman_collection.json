      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('слоты упорядочены по времени', () => {",
              "  const t = b.items.map(s => Date.parse(s.start_at));",
              "  pm.expect(t).to.eql([...t].sort((x, y) => x - y));",
              "});"
            ]
          }
        }
      ],
